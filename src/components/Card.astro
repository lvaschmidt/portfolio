---
interface Props {
  // href: string;
  badge?: string;
}

const { badge } = Astro.props;
---

<li class="link-card">
  <!-- <a href={href} target="_blank"> -->
    <div class="mb-2.5 flex items-center gap-3">
      <h2 class="inline text-xl font-semibold tracking-tight text-gray-900 dark:text-gray-100">
        <slot name="title">
      </h2>
      {
        badge && (
          <span class="dark:bg-gray-800 bg-gray-200 dark:text-gray-200 text-gray-900  ml-2 rounded-lg px-2 py-0.5 font-mono text-xs no-underline">
            {badge}
          </span>
        )
      }
    </div>
  <!-- </a> -->
  <div class="text-gray-600 dark:text-gray-400"><slot/></div>
</li>
