<button class="border-0 flex items-center justify-center" id="themeToggle">
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="rotate-0 scale-100 transition-all dark:-rotate-90 dark:scale-0"
    ><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path
      d="M12 20v2"></path><path d="m4.93 4.93 1.41 1.41"></path><path
      d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"></path><path
      d="M20 12h2"></path><path d="m6.34 17.66-1.41 1.41"></path><path
      d="m19.07 4.93-1.41 1.41"></path></svg
  >
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="absolute rotate-90 scale-0 transition-all dark:rotate-0 dark:scale-100"
    ><path d="M12 3a6.364 6.364 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg
  >
</button>

<style>
  #themeToggle {
    border: 0;
    background: none;
  }
  .sun {
    fill: black;
  }
  .moon {
    fill: transparent;
  }

  :global(.dark) .sun {
    fill: transparent;
  }
  :global(.dark) .moon {
    fill: white;
  }
</style>

<script is:inline>
  const THEME_KEY = "theme";
  const THEME_DATE_KEY = "theme_set_time";
  const THEME_TIMEOUT = 30 * 60 * 1000; // 30 minutes in ms

  function getSavedTheme() {
    const theme = localStorage.getItem(THEME_KEY);
    const setTime = localStorage.getItem(THEME_DATE_KEY);
    if (theme && setTime) {
      if (Date.now() - parseInt(setTime, 10) < THEME_TIMEOUT) {
        return theme;
      } else {
        localStorage.removeItem(THEME_KEY);
        localStorage.removeItem(THEME_DATE_KEY);
      }
    }
    return null;
  }

  // Get theme, considering expiration
  const savedTheme = typeof localStorage !== "undefined" ? getSavedTheme() : null;
  let theme;
  if (savedTheme) {
    theme = savedTheme;
  } else if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
    theme = "dark";
  } else {
    theme = "light";
  }

  if (theme === "light") {
    document.documentElement.classList.remove("dark");
  } else {
    document.documentElement.classList.add("dark");
  }

  // Only store if no (valid) savedTheme
  if (!savedTheme) {
    localStorage.setItem(THEME_KEY, theme);
    localStorage.setItem(THEME_DATE_KEY, Date.now().toString());
  }

  const handleToggleClick = () => {
    const element = document.documentElement;
    element.classList.toggle("dark");
    const isDark = element.classList.contains("dark");
    localStorage.setItem(THEME_KEY, isDark ? "dark" : "light");
    localStorage.setItem(THEME_DATE_KEY, Date.now().toString());
  };

  document
    .getElementById("themeToggle")
    .addEventListener("click", handleToggleClick);
</script>